{
  "name": "nomad-poker-near-web",
  "private": true,
  "version": "0.1.0",
  "description": "Back a pro's poker agent on NEAR, watch it play, and check every hand",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/copy-wasm.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@hot-labs/near-connect": "0.12.0",
    "near-api-js": "7.5.3"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vite": "6.0.7"
  }
}
