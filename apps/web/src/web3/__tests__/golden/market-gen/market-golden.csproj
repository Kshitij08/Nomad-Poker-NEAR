<Project Sdk="Microsoft.NET.Sdk">
  <!-- Golden vectors for the copied SOL strategy (NomadUiHost.Market CopiedSol + NomadUiHost.Onchain OnchainDeployOrStop):
       the agent_set encoding with fee terms from the REAL generated bindings (Per/Core/Generated/PokerPerIdl.cs + Borsh.cs),
       Newtonsoft's text for SolProfile, and the "0.#" fee percents of the dialogs. NomadUiHost itself is a MonoBehaviour
       (TMPro, uGUI), so Program.cs carries verbatim copies of ValuesOf / ApplyProfile / SolProfile and the dialog lines.
       Run: dotnet run -c Release (output path argument: ../market-golden.json) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../../../../Assets/Scripts/Per/Core/Borsh.cs" />
    <Compile Include="../../../../../../Assets/Scripts/Per/Core/Generated/PokerPerIdl.cs" />
  </ItemGroup>
</Project>
