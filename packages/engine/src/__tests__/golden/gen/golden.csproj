<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1574;CS1584;CS1581;CS1580;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(UNITY_REPO)/Assets/Scripts/Core/Cards/*.cs" />
    <Compile Include="$(UNITY_REPO)/Assets/Scripts/Core/Evaluation/*.cs" />
    <Compile Include="$(UNITY_REPO)/Assets/Scripts/Core/Actions/*.cs" />
    <Compile Include="$(UNITY_REPO)/Assets/Scripts/Core/State/*.cs" />
    <Compile Include="$(UNITY_REPO)/Assets/Scripts/Core/Engine/*.cs" />
    <Compile Include="$(UNITY_REPO)/Assets/Scripts/Core/Events/PokerEvent.cs" />
    <Compile Include="$(UNITY_REPO)/Assets/Scripts/Bots/*.cs" />
    <Compile Include="$(UNITY_REPO)/Assets/Scripts/Core/Events/PokerTokenHash.cs" />
    <Compile Include="$(UNITY_REPO)/Assets/Scripts/Core/Social/AvatarCatalog.cs" />
  </ItemGroup>
</Project>
