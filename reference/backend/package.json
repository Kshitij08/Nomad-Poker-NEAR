{
  "name": "poker-escrow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "copy-idl": "node scripts/copy-idl.mjs",
    "prebuild": "npm run copy-idl",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "migrate": "node --import tsx src/db/migrate.ts",
    "reconcile": "node --import tsx src/jobs/reconcile.ts",
    "db:backfill": "node --import tsx src/jobs/backfill-db.ts",
    "start": "node dist/db/migrate.js && node dist/index.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/web3.js": "^1.95.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
