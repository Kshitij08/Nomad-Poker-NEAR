<Project Sdk="Microsoft.NET.Sdk">
  <!-- Golden-vector generator for the on-chain engine (M5). Compiles the game's own Poker.Core
       sources as they are (no copies), plays random hands and writes what the C# engine did. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Assets\Scripts\Core\**\*.cs" />
  </ItemGroup>
</Project>
