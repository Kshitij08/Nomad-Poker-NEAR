# Backend environment (devnet)

# --- Database (Railway Postgres) ---
# Local dev: use the PUBLIC URL (Railway → Postgres → Connect → Public Network).
# Railway-deployed backend: reference the private URL, e.g. ${{Postgres.DATABASE_URL}}.
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.app:PORT/railway
DATABASE_URL=
DATABASE_SSL=true

# --- Solana ---
SOLANA_RPC_URL=https://rpc.magicblock.app/devnet/
POKER_PROGRAM_ID=GdduGzsoiEamv285Z4DnBapmkMScnHLDdUAdWPywHozo
SETTLEMENT_AUTHORITY_SECRET=

# --- HTTP ---
PORT=8787

# Required before exposing /internal/* publicly (Railway, etc.)
# Clients send: X-API-Key: <value>  or  Authorization: Bearer <value>
INTERNAL_API_KEY=

# Player wallet login (SIWS) — required for /api/auth/* and /api/me
# Use a long random string (min 16 chars). Never reuse INTERNAL_API_KEY.
JWT_SECRET=
# Optional JWT lifetime (jose format), default 7d
# JWT_TTL=7d
# Domain shown in the sign-in message players approve in their wallet
# AUTH_DOMAIN=poker.app

# --- Clients (optional) ---
# After deploying the backend to Railway, set this to your public service URL.
# Unity: set Backend Url on PokerChainTestUI to the same value.
# Scripts: BACKEND_URL or BACKEND_PUBLIC_URL for npm run devnet:settle
# INTERNAL_API_KEY must match backend when auth is enabled
# BACKEND_PUBLIC_URL=https://your-service.up.railway.app
