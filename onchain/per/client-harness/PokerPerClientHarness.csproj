<Project Sdk="Microsoft.NET.Sdk">
  <!-- M8: runs the Unity client's private-table core (Assets/Scripts/Per/Core) outside Unity, against
       devnet, with the same Solana SDK DLLs the game ships. Compiles the sources as they are. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Assets\Scripts\Core\**\*.cs" />
    <Compile Include="..\..\Assets\Scripts\Per\Core\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Solana.Unity.Wallet"><HintPath>..\..\Packages\com.solana.unity_sdk\Packages\Solana.Unity.Wallet.dll</HintPath></Reference>
    <Reference Include="Solana.Unity.Rpc"><HintPath>..\..\Packages\com.solana.unity_sdk\Packages\Solana.Unity.Rpc.dll</HintPath></Reference>
    <Reference Include="Chaos.NaCl"><HintPath>..\..\Packages\com.solana.unity_sdk\Packages\Chaos.NaCl.dll</HintPath></Reference>
    <Reference Include="BouncyCastle.Cryptography"><HintPath>..\..\Packages\com.solana.unity_sdk\Packages\BouncyCastle.Cryptography.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
